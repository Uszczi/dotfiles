#!/usr/bin/bash

set -euo pipefail

if ! command -v yay &>/dev/null; then
    sudo pacman -S --needed --noconfirm git base-devel
    yay_tmp="$(mktemp -d)"
    trap 'rm -rf "$yay_tmp"' EXIT
    git clone https://aur.archlinux.org/yay-bin.git "$yay_tmp/yay-bin"
    (cd "$yay_tmp/yay-bin" && makepkg -si --noconfirm)
    rm -rf "$yay_tmp"
    trap - EXIT
else
    echo "yay installed, skipped."
fi

sudo pacman -S --needed --noconfirm tmux
sudo pacman -S --needed --noconfirm fd
sudo pacman -S --needed --noconfirm go
sudo pacman -S --needed --noconfirm just

yay -S --noconfirm --needed fzf

# TODO Switch to nvm
yay -S --noconfirm --needed nodejs npm bun
sudo pacman -S --needed --noconfirm pnpm

yay -S --noconfirm --needed go
yay -S --noconfirm --needed gimp
yay -S --noconfirm --needed stylua

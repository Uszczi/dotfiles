#!/usr/bin/bash

mkdir -p ~/.config
rm -rf ~/.config/nvim

cp -r ~/dotfiles/prod/nvim ~/.config/
cp -r ~/dotfiles/prod/tmux ~/.config/
cp -r ~/dotfiles/prod/tmux-sessionizer ~/.config/

cp -r ~/dotfiles/prod/hypr ~/.config/
cp -r ~/dotfiles/prod/quickshell/ ~/.config/
# cp -r ~/dotfiles/prod/sway ~/.config/
# cp -r ~/dotfiles/prod/i3 ~/.config/
# cp -r ~/dotfiles/prod/i3status ~/.config/

cp ~/dotfiles/prod/.bashrc ~/.bashrc
cp ~/dotfiles/prod/.zshrc ~/.zshrc

mkdir -p ~/.agents/skills ~/.claude/skills
for skill in ~/dotfiles/prod/agents/skills/*/; do
    name=$(basename "$skill")
    mkdir -p ~/.agents/skills/"$name"
    cp -rT "$skill" ~/.agents/skills/"$name"
    if [ ! -e ~/.claude/skills/"$name" ] && [ ! -L ~/.claude/skills/"$name" ]; then
        ln -s ../../.agents/skills/"$name" ~/.claude/skills/"$name"
    fi
done
